{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // A bare "docs/.vitepress" would match nothing: TypeScript skips dot-directories
  // unless the pattern continues past them. The .vue glob is for the Vue language server.
  "include": ["src", "docs/.vitepress/**/*", "docs/.vitepress/**/*.vue", "vite.config.ts"],
  "exclude": ["docs/.vitepress/cache", "docs/.vitepress/dist"]
}
