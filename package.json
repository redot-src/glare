{
  "name": "@redot-src/glare",
  "version": "1.1.0",
  "description": "Modern, touch-enabled, fully customizable lightbox for the web — zero dependencies.",
  "type": "module",
  "license": "MIT",
  "author": "Glare Contributors",
  "homepage": "https://redot-src.github.io/glare/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redot-src/glare.git"
  },
  "bugs": {
    "url": "https://github.com/redot-src/glare/issues"
  },
  "keywords": [
    "lightbox",
    "gallery",
    "modal",
    "zoom",
    "image",
    "video",
    "touch",
    "responsive",
    "typescript",
    "vanilla"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./dist/glare.esm.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/glare.js",
  "jsdelivr": "./dist/glare.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glare.esm.js",
      "default": "./dist/glare.esm.js"
    },
    "./style.css": "./dist/glare.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite --mode demo",
    "build": "npm run typecheck && vite build && vite build --mode umd && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "demo:build": "vite build --mode demo",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "pages:build": "npm run docs:build && npm run demo:build",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitepress": "^1.6.4"
  }
}
